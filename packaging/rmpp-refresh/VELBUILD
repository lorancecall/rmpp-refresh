# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. Scripts never restart xochitl themselves: they re-arm
# the transient timer rmpp-restart-xochitl (15 s, runs /usr/lib/rmpp/restart), so a transaction restarts it once.
# Root file system: everything under /usr/lib/rmpp (rmpp-preload's layout); a file xochitl may have loaded is
# renamed to *.old or moved to /usr/lib/rmpp/.trash, never deleted, and /usr/lib/rmpp/restart deletes it after the
# restart. Plain `mount -o remount,rw|ro /`: Vellum's mount-rw unmounts /etc recursively, which also drops the
# /etc/dropbear bind mount (SSH host key) until the next boot.

package() {
	install -Dm755 "$srcdir"/librmpp-refresh.so "$pkgdir"/home/root/.vellum/share/rmpp-refresh/librmpp-refresh.so

	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/$upstream_author/rmpp-refresh" > "$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	mount -o remount,rw /
	# older versions put files in /usr/lib/rmpp-refresh: set aside (deleted after the restart)
	if [ -e /usr/lib/rmpp-refresh ]; then
		mkdir -p /usr/lib/rmpp/.trash
		rm -f /usr/lib/rmpp-preload.d/50-rmpp-refresh.so
		[ ! -e /usr/lib/rmpp-refresh ] || mv /usr/lib/rmpp-refresh /usr/lib/rmpp/.trash/usr_lib_rmpp-refresh.$$
	fi
	mkdir -p /usr/lib/rmpp/rmpp-refresh /usr/lib/rmpp/preload.d
	cp "/home/root/.vellum/share/rmpp-refresh"/librmpp-refresh.so /usr/lib/rmpp/rmpp-refresh/librmpp-refresh.so.new && chmod 755 /usr/lib/rmpp/rmpp-refresh/librmpp-refresh.so.new && { [ ! -e /usr/lib/rmpp/rmpp-refresh/librmpp-refresh.so ] || mv -f /usr/lib/rmpp/rmpp-refresh/librmpp-refresh.so /usr/lib/rmpp/rmpp-refresh/librmpp-refresh.so.old; } && mv -f /usr/lib/rmpp/rmpp-refresh/librmpp-refresh.so.new /usr/lib/rmpp/rmpp-refresh/librmpp-refresh.so
	ln -sfn ../rmpp-refresh/librmpp-refresh.so /usr/lib/rmpp/preload.d/50-rmpp-refresh.so
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c '[ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
}

